# Optional local settings. Copy to .env only when automatic detection needs help.
# Keep .env private. Never put credentials, tokens, or conversation data here.
# Non-empty process environment values take precedence over this file.
# Leave values empty to keep automatic detection/defaults.
# Use absolute paths. Use SINGLE quotes for Windows paths, especially with #.
# Double quotes can turn backslash-n into a newline. No %VARIABLE% or ~ expansion.
# Example: AGENT_INBOX_CODEX_HOME='C:\new\Codex # local'
# Example: AGENT_INBOX_VSCODE_PATH='C:\Tools\VS Code\Code.exe'

# Codex data directory: otherwise CODEX_HOME, then the current user's .codex.
AGENT_INBOX_CODEX_HOME=

# Full path to Code.exe: otherwise search the standard installations and PATH.
AGENT_INBOX_VSCODE_PATH=

# Advanced override. Default local Windows pipe: \\.\pipe\codex-ipc
AGENT_INBOX_CODEX_PIPE=

# Default 1. Set 0 to use manual session lookup instead of Codex deep links.
AGENT_INBOX_VERIFIED_CODEX_LINKS=

# Startup default when no saved UI choice exists. The titlebar Avatar menu
# switches immediately and saves a local preference that takes precedence.
# auto: complete .local/avatar/personal theme when present, else open-source.
# open-source: bundled public avatars. Changing this default requires a restart.
AVATAR_THEME=auto
